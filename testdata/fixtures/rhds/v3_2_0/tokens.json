{
  "$extensions": {
    "com.rhds.mcp": {
      "sourcePackage": "@rhds/tokens",
      "sourceVersion": "3.2.0",
      "sourceFile": "json/rhds.tokens.json",
      "sourceIntegrity": "sha512-YyeRPr2ThFGclyky4PCruj9f7e15yP2xnT3ZTJeU64+k5ICb/YezaKjJs8Dc48WHDhINHCgMt+VecfM86GExuQ==",
      "normalizedSchema": "draft",
      "styleDictionaryFields": "dropped",
      "generatedColorAliases": 160,
      "retainedGeneratedAliases": [
        "color.red-orange.60-rgb",
        "color.red-orange.60-hsl"
      ],
      "excludedLightDark": 57,
      "recoveredTypes": 18,
      "typeMapping": {
        "radius": "dimension",
        "letter-spacing": "dimension",
        "line-height": "number",
        "opacity": "number"
      },
      "valueNormalization": {
        "aliases": "original.$value references are never rewritten",
        "duration": "seconds converted to millisecond strings, e.g. 0.3s to 300ms",
        "number": "percentage strings converted to unitless JSON numbers, e.g. 50% to 0.5",
        "color": "literal colors converted to #RRGGBB or #RRGGBBAA, e.g. rgba(21, 21, 21, 0.25) to #15151540",
        "dimension": "unitless zero sub-values converted to 0px"
      }
    }
  },
  "animation": {
    "speed": {
      "$value": "300ms",
      "$type": "duration",
      "$extensions": {
        "com.rhds.mcp": {
          "sourceValue": "0.3s"
        }
      }
    },
    "timing": {
      "$value": [
        0.465,
        0.183,
        0.153,
        0.946
      ],
      "$type": "cubicBezier"
    }
  },
  "border": {
    "radius": {
      "default": {
        "$value": "{length.2xs}",
        "$type": "dimension",
        "$description": "Applies a 3px border radius to at least 1 corner of a container. This shall be the default for all containers needing rounded corners. It should be used to soften a container's visual footprint. Recommended for elements with subtle rounded corners like Button, Card, or Dialog. It must be applied to all 4 corners of a container at once."
      },
      "sharp": {
        "$value": "0.0px",
        "$type": "dimension",
        "$description": "This token resets the border radius of a container back to 0 or sharp. It must be applied to all 4 corners of a container at once."
      },
      "$extensions": {
        "com.redhat.ux": {
          "heading": "Radius"
        }
      }
    },
    "width": {
      "sm": {
        "$value": "{length.4xs}",
        "$type": "dimension",
        "$description": "Applies a 1px border width to at least 1 side of a container. This shall be the default width for all borders and lines. It should be used to establish baseline thickness or visual separation with a container or thin line. It must not be used for strong directional emphasis like indicating a selected state. Recommended for elements like Button, Card, or Field. Applying to all 4 sides at once is optional."
      },
      "$extensions": {
        "com.redhat.ux": {
          "heading": "Width"
        }
      }
    }
  },
  "box-shadow": {
    "md": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "{length.xs}",
        "blur": "{length.sm}",
        "spread": "{length.4xs}",
        "color": "#15151540"
      },
      "$type": "shadow",
      "$description": "Medium box shadow"
    }
  },
  "breakpoint": {
    "sm": {
      "$value": "768px",
      "$type": "dimension",
      "$description": "Mobile landscape",
      "$extensions": {
        "com.redhat.ux": {
          "title": "Small"
        }
      }
    },
    "xs": {
      "$value": "576px",
      "$type": "dimension",
      "$description": "Mobile portrait",
      "$extensions": {
        "com.redhat.ux": {
          "title": "Extra Small"
        }
      }
    },
    "$extensions": {
      "com.redhat.ux": {
        "use": "breakpoint",
        "heading": "Breakpoints",
        "descriptionFile": "breakpoints.md",
        "description": {}
      }
    }
  },
  "color": {
    "border": {
      "destructive": {
        "on-light": {
          "$value": "{color.border.status.danger.on-light}",
          "$type": "color",
          "$description": "Destructive border color (light theme)"
        }
      },
      "status": {
        "danger": {
          "on-light": {
            "$value": "{color.status.danger.on-light}",
            "$type": "color",
            "$description": "Danger border color (light theme)"
          }
        }
      },
      "$extensions": {
        "com.redhat.ux": {
          "category": "border",
          "collapse": true,
          "order": 80,
          "heading": "Color"
        }
      }
    },
    "red-orange": {
      "60": {
        "$value": "#B1380B",
        "$type": "color",
        "$extensions": {
          "com.redhat.print": {
            "colorSpace": "cmyk",
            "components": [
              0,
              90,
              100,
              20
            ]
          }
        }
      },
      "60-hsl": {
        "$value": "{color.red-orange.60}",
        "$type": "color",
        "$deprecated": "Use color transforms instead e.g. hsla(from var(--rh-color-red-orange-60) h s l / 10%)"
      },
      "60-rgb": {
        "$value": "{color.red-orange.60}",
        "$type": "color",
        "$deprecated": "Use color transforms instead e.g. rgba(from var(--rh-color-red-orange-60) r g b / 10%)"
      },
      "$extensions": {
        "isCrayon": true,
        "com.redhat.ux": {
          "order": 301,
          "description": "The red orange color is reserved for danger or error states. Do not use it anywhere else."
        }
      }
    },
    "status": {
      "danger": {
        "on-light": {
          "$value": "{color.red-orange.60}",
          "$type": "color",
          "$description": "Danger status color (light theme)"
        },
        "$description": "Represents an action which could have destructive consequences, e.g. deleting a file."
      },
      "$extensions": {
        "com.redhat.ux": {
          "order": 500
        }
      }
    },
    "$extensions": {
      "com.redhat.ux": {
        "heading": "Global color",
        "description": "Color helps create consistent experiences across web properties. Various colors are available in two themes, light and dark."
      }
    }
  },
  "font": {
    "family": {
      "heading": {
        "$value": [
          "RedHatDisplay",
          "Red Hat Display",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$type": "fontFamily",
        "$description": "Heading font family",
        "$extensions": {
          "com.redhat.ux": {
            "example": "Display"
          }
        }
      },
      "$extensions": {
        "com.redhat.ux": {
          "heading": "Font family",
          "description": "[Red Hat Fonts](https://github.com/RedHatOfficial/RedHatFont), designed by Jeremy Mickel\nand released under Open Font License, form the typographic basis for the Red Hat Design\nSystem. Pages using non-latin characters should fall back to\n[Noto Sans](https://notofonts.github.io/). By loading language-specific Noto\nSans fonts, <abbr title=\"Red Hat Design System\">RHDS</abbr> can accomodate mixed-language\ncontent including <span lang=\"ar\">العربية</span>, <span lang=\"he\">עברית</span>,\n<span lang=\"jp\">日本語</span>, <span lang=\"kr\">조선말</span>, <span lang=\"ml\">മലയാളം</span>,\n<span lang=\"zh\">汉语</span>, <span lang=\"zh\">漢語</span>, or <span lang=\"th\">ภาษาไทย</span>.\n\nUsers may load those fonts from Google Fonts, for example with this HTML snippet pasted\ninto the `<head>`:\n\n```html\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+Hebrew:wght@500;700&family=Noto+Sans+JP:wght@500;700&family=Noto+Sans+KR:wght@500;700&family=Noto+Sans+Malayalam:wght@500;700&family=Noto+Sans+SC:wght@500;700&family=Noto+Sans+TC:wght@500;700&family=Noto+Sans+Tamil:wght@500;700&family=Noto+Sans+Thai:wght@500;700&display=swap\" rel=\"stylesheet\">\n```"
        }
      }
    },
    "size": {
      "body-text": {
        "md": {
          "$value": "1rem",
          "$type": "dimension",
          "$description": "16px font size"
        },
        "$extensions": {
          "com.redhat.ux": {
            "heading": "Font size (text)",
            "example": "Aa"
          }
        }
      }
    },
    "weight": {
      "heading": {
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$description": "Bold font weight for headings"
        },
        "$extensions": {
          "com.redhat.ux": {
            "heading": "Font weights (headings)",
            "fontFamily": "var(--rh-font-family-heading)"
          }
        }
      },
      "$extensions": {
        "com.redhat.ux": {
          "heading": "Font weights"
        }
      }
    },
    "$extensions": {
      "com.redhat.ux": {
        "heading": "Typography",
        "description": "To learn more about how to use text, visit the [typography page](https://ux.redhat.com/foundations/typography)."
      }
    }
  },
  "length": {
    "2xs": {
      "$value": "3px",
      "$type": "dimension",
      "$description": "3px length token"
    },
    "4xs": {
      "$value": "1px",
      "$type": "dimension",
      "$description": "1px length token"
    },
    "sm": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "6px length token"
    },
    "xs": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "4px length token"
    }
  },
  "letter-spacing": {
    "body": {
      "text": {
        "$value": "0.0125rem",
        "$type": "dimension",
        "$description": "Extra letter spacing for small body text sizes"
      }
    }
  },
  "line-height": {
    "body-text": {
      "$value": 1.5,
      "$type": "number",
      "$description": "Line height for body text"
    },
    "$extensions": {
      "com.redhat.ux": {
        "heading": "Line height",
        "example": "Line<br/>height"
      }
    }
  },
  "media": {
    "sm": {
      "$value": {
        "min-width": "{breakpoint.sm}"
      },
      "$type": "mediaQuery",
      "$description": "Mobile landscape",
      "$extensions": {
        "com.redhat.ux": {
          "title": "Small"
        }
      }
    },
    "$extensions": {
      "com.redhat.ux": {
        "use": "breakpoint",
        "heading": "Media Queries",
        "descriptionFile": "media.md",
        "description": {}
      }
    }
  },
  "opacity": {
    "50": {
      "$value": 0.5,
      "$type": "number",
      "$description": "50% opacity",
      "$extensions": {
        "com.rhds.mcp": {
          "sourceValue": "50%"
        }
      }
    }
  }
}
